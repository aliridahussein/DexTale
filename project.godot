; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="The Thirteenth Bell"
config/description="A short medieval dark-fantasy mystery. Every night the bell saves the village. Every night, someone forgets why."
config/version="0.1.0"
run/main_scene="res://scenes/main/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.039, 0.035, 0.059, 1)
boot_splash/show_image=false
config/icon="res://assets/sprites/ui/icon.png"

[autoload]

Settings="*res://scripts/autoload/settings.gd"
GameState="*res://scripts/autoload/game_state.gd"
QuestManager="*res://scripts/autoload/quest_manager.gd"
DialogueManager="*res://scripts/autoload/dialogue_manager.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"
SceneManager="*res://scripts/autoload/scene_manager.gd"
UI="*res://scenes/ui/ui.tscn"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[gui]

theme/custom="res://assets/ui/theme.tres"

